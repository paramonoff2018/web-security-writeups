# 🚨 Секреты и конфиги (НИКОГДА не пушим!)
*.yaml
*.yml
*.json
.env
*apiKey*
*secret*
*token*
config.*

# 🚫 Исключаем настройки редактора и ОС
.vscode/
.idea/
.DS_Store
Thumbs.db

# 🧠 Исключаем локальные базы данных и кэш (если появятся)
*.db
*.sqlite
*.log

# 📦 Исключаем тяжелые артефакты разведки (оставляем только текст)
# Если мы скачаем JS-файлы, мы не будем пушить их в Git, 
# так как они весят мегабайты и могут засорить репозиторий.
02_Recon/js_files/*.js
02_Recon/js_files/*.map

# 📁 Исключаем временные папки
tmp/
temp/